// SPDX-License-Identifier: GPL-2.0-only
/*
 * Include in a board DTS defining lora_i2c, lora_spi and LORA_IRQ_SPEC.
 * Example LORA_IRQ_SPEC for a generic two-cell interrupt controller:
 *   #define LORA_IRQ_SPEC &gpio 7 IRQ_TYPE_LEVEL_HIGH
 * Allwinner uses three cells, e.g. &pio BANK PIN IRQ_TYPE_LEVEL_HIGH.
 * Choose BANK/PIN from the actual board; no SoC numbering is baked in here.
 * Expand this pattern to TCA9554 addresses 0x20..0x27 for eight modules.
 */
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

&lora_i2c {
	status = "okay";
	lora_gpio0: gpio@20 {
		compatible = "ti,tca9554";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
	};
	lora_gpio1: gpio@21 {
		compatible = "ti,tca9554";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
	};
};

&lora_spi {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	cs-gpios = <&lora_gpio0 5 GPIO_ACTIVE_LOW>,
		   <&lora_gpio1 5 GPIO_ACTIVE_LOW>;

	lora0: radio@0 {
		compatible = "ebyte,e22-x00m30s", "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <1000000>;
		interrupts-extended = <LORA_IRQ_SPEC>;
		reset-gpios = <&lora_gpio0 6 GPIO_ACTIVE_LOW>;
		busy-gpios = <&lora_gpio0 7 GPIO_ACTIVE_HIGH>;
		dio1-gpios = <&lora_gpio0 4 GPIO_ACTIVE_HIGH>;
		txen-gpios = <&lora_gpio0 1 GPIO_ACTIVE_HIGH>;
		rxen-gpios = <&lora_gpio0 2 GPIO_ACTIVE_HIGH>;
	};

	lora1: radio@1 {
		compatible = "ebyte,e22-x00m30s", "semtech,sx1262";
		reg = <1>;
		spi-max-frequency = <1000000>;
		interrupts-extended = <LORA_IRQ_SPEC>;
		reset-gpios = <&lora_gpio1 6 GPIO_ACTIVE_LOW>;
		busy-gpios = <&lora_gpio1 7 GPIO_ACTIVE_HIGH>;
		dio1-gpios = <&lora_gpio1 4 GPIO_ACTIVE_HIGH>;
		txen-gpios = <&lora_gpio1 1 GPIO_ACTIVE_HIGH>;
		rxen-gpios = <&lora_gpio1 2 GPIO_ACTIVE_HIGH>;
	};
};
